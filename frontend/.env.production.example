#
# Reference only — not read directly by Vite. Set these as real environment
# variables in your hosting dashboard (e.g. Vercel -> Project -> Settings ->
# Environment Variables) once you have your deployed backend gateway's URL.
#
# All four point at the SAME gateway domain, differing only by path prefix —
# see gateway/main.py, which reverse-proxies /person1/* etc. to each engine.
# No frontend code changes are needed to go from local to deployed; only these
# four values change.

VITE_PERSON1_API_URL=https://YOUR-BACKEND-DOMAIN/person1
VITE_PERSON2_API_URL=https://YOUR-BACKEND-DOMAIN/person2
VITE_PERSON3_API_URL=https://YOUR-BACKEND-DOMAIN/person3
VITE_PERSON4_API_URL=https://YOUR-BACKEND-DOMAIN/person4

VITE_MOCK_PERSON3=false
VITE_MOCK_PERSON4=false
