# Local dev defaults — each engine runs as its own FastAPI process/port.
# Override in .env.development.local (gitignored) if your ports differ.

VITE_PERSON1_API_URL=http://localhost:8000
VITE_PERSON2_API_URL=http://localhost:8001
VITE_PERSON3_API_URL=http://localhost:8002
VITE_PERSON4_API_URL=http://localhost:8003

# All four engines are live — set both to true to fall back to the hardcoded
# mocks in src/mocks/ (useful for frontend-only dev without the Python engines
# running). Mock response shapes match the real engines exactly.
VITE_MOCK_PERSON3=false
VITE_MOCK_PERSON4=false
